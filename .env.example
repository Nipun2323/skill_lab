# Copy to .env to override defaults from config.py. Never commit .env.
# Leave SECRET_KEY empty to have one generated into instance/secret_key on first start.
SECRET_KEY=

# Files (relative to the project folder)
RAW_DATA_PATH=data/raw/dataset_TSMC2014_NYC.txt
VENUES_PATH=data/venues.csv.gz
SAMPLES_PATH=data/samples/synthetic_histories.json.gz
DATABASE_PATH=instance/syncromove.db
EVAL_RESULTS_PATH=docs/evaluation_results.json

# Algorithm constants (fixed by design; re-run scripts/evaluate.py after any change)
MARKOV_ORDER=1
HISTORY_LENGTH=1000
W_TRANSITION=0.40
W_TIME=0.30
W_FREQUENCY=0.20
W_RECENCY=0.10
W_POPULARITY=0.001
RECENT_WINDOW=20
RECENT_DECAY=0.8
TIME_BUCKET_HOURS=3
COLLAPSE_REPEATS=true

# Evaluation and import
EVAL_TEST_FRACTION=0.2
SAMPLE_USERS=25
RANDOM_SEED=42

# App
TOP_K=3
MAX_K=10
PASSWORD_MIN=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
SESSION_HOURS=12
HOST=127.0.0.1
PORT=5000
